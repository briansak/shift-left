# Shift-Left Review Pipeline — environment template
# Copy to .env and customize.
#
# INSTALL/UPDATE: egress to GitHub, Hugging Face, registries is expected when
# you run `./scripts/shift-left install` or `update`.
# RUNTIME: customer artifacts never egress — see docs/distribution-and-sovereignty.md
# Forgejo bundled git (default sovereign backend)
FORGEJO_TOKEN=

# Only if git.backend is github or gitlab (see docs/git-backends.md):
# GITHUB_TOKEN=
# GITLAB_TOKEN=

# Postgres password for Forgejo (change in production)
POSTGRES_PASSWORD=forgejo-dev-only

# Host URLs (for browser access only — not used for runtime egress)
FORGEJO_ROOT_URL=http://localhost:3000
FORGEJO_PORT=3000
FORGEJO_SSH_PORT=2222
ORCHESTRATOR_PORT=8080

# Hugging Face (install-time only) — verified repo ids in docs/licensing.md
# HF_TOKEN=                          # required for gated Antares download
# ANTARES_HF_REPO_ID=fdtn-ai/antares-1b
# FOUNDATION_SEC_HF_REPO_ID=fdtn-ai/Foundation-Sec-1.1-8B-Instruct-Q8_0-GGUF
# FOUNDATION_SEC_GGUF_GLOB=foundation-sec-1.1-8b-instruct-q8_0.gguf

# NVD API key (optional, sync-reference-data --fetch-nvd only)
# NVD_API_KEY=

# Apple Silicon: run inference natively with MPS, point orchestrator at host
# ANTARES_SERVICE_URL=http://host.docker.internal:8090
# FOUNDATION_SEC_SERVICE_URL=http://host.docker.internal:8091
# Absolute path to this repo on the host (optional; auto-detected from the /shift-left bind mount).
# SHIFT_LEFT_HOST_REPO_ROOT=/Users/you/code/shift-left
# Host-native Antares: snapshot dir must be Docker-bind-mountable (set automatically by ./shift-left model start).
# ANTARES_SNAPSHOT_DIR=/Users/you/code/shift-left/data/findings/antares-snapshots
# ANTARES_MODEL_HOST_PATH=./models/1b
# FOUNDATION_SEC_MODEL_HOST_PATH=./models/foundation-sec-q8_0
# FOUNDATION_SEC_GGUF_GLOB=foundation-sec-1.1-8b-instruct-q8_0.gguf

# Host-native model servers: loopback bind + egress probe (see README)
# SHIFT_LEFT_SKIP_EGRESS_PROBE=1   # local dev only — not for production

# Linux container inference profile: docker compose --profile linux-cpu up
# ANTARES_BACKEND=cpu
# FOUNDATION_SEC_GGUF_GLOB=*.gguf
