    },
    {
      "path": "gcp-open-firewall.tf",
      "expect_flagged": true,
      "expected_rule": "terraform/gcp-unrestricted-ingress",
      "source": "public IaC pattern (GCP provider docs shape)"
    },
    {
      "path": "fmc-allow-inbound.tf",
      "expect_flagged": true,
      "expected_rule": "terraform/fmc-unrestricted-ingress",
