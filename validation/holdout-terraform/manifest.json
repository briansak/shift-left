    },
    {
      "path": "aws-scoped-sg.tf",
      "expect_flagged": false,
      "source": "private RFC1918 scoped ingress"
    },
    {
      "path": "aws-commented-open.tf",
      "expect_flagged": false,
      "source": "fully commented permissive rule"
    },
    {
      "path": "aws-var-cidr.tf",
